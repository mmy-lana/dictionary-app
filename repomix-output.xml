export class AudioController {
  private audio: HTMLAudioElement | null = null;
  private onStateChange: ((isPlaying: boolean, isLoading: boolean, error: string | null) => void) | null = null;

  constructor(onStateChange?: (isPlaying: boolean, isLoading: boolean, error: string | null) => void) {
    this.onStateChange = onStateChange || null;
  }

  public play(url: string, wordText?: string): Promise<void> {
    return new Promise((resolve, reject) => {
      this.stop();

      if (!url && wordText) {
        return this.speakText(wordText, resolve, reject);
      }

      if (!url) {
        const errorMsg = 'No audio source available.';
        this.notify(false, false, errorMsg);
        return reject(new Error(errorMsg));
      }

      this.notify(false, true, null);
      this.audio = new Audio(url);

      this.audio.oncanplaythrough = () => {
        this.audio?.play()
          .then(() => {
            this.notify(true, false, null);
            resolve();
          })
          .catch(() => {
            if (wordText) {
              this.speakText(wordText, resolve, reject);
            } else {
              const errorMsg = 'Failed to play audio.';
              this.notify(false, false, errorMsg);
              reject(new Error(errorMsg));
            }
          });
      };

      this.audio.onended = () => {
        this.notify(false, false, null);
      };

      this.audio.onerror = () => {
        this.audio = null;
        if (wordText && typeof window !== 'undefined' && 'speechSynthesis' in window) {
          this.speakText(wordText, resolve, reject);
        } else {
          const errorMsg = 'Unable to load remote audio.';
          this.notify(false, false, errorMsg);
          reject(new Error(errorMsg));
        }
      };
    });
  }

  private speakText(text: string, resolve: () => void, reject: (reason?: unknown) => void): void {
    if (typeof window === 'undefined' || !('speechSynthesis' in window)) {
      const errorMsg = 'Speech synthesis unavailable.';
      this.notify(false, false, errorMsg);
      return reject(new Error(errorMsg));
    }

    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = 'en-US';
    utterance.rate = 0.9;

    utterance.onstart = () => {
      this.notify(true, false, null);
    };

    utterance.onend = () => {
      this.notify(false, false, null);
      resolve();
    };

    utterance.onerror = (e) => {
      this.notify(false, false, 'Speech synthesis error.');
      reject(e);
    };

    window.speechSynthesis.speak(utterance);
  }

  public stop(): void {
    if (typeof window !== 'undefined' && 'speechSynthesis' in window) {
      window.speechSynthesis.cancel();
    }
    if (this.audio) {
      this.audio.pause();
      this.audio.currentTime = 0;
      this.audio = null;
    }
    this.notify(false, false, null);
  }

  private notify(isPlaying: boolean, isLoading: boolean, error: string | null): void {
    if (this.onStateChange) {
      this.onStateChange(isPlaying, isLoading, error);
    }
  }

  public destroy(): void {
    this.stop();
    this.onStateChange = null;
  }
}
